# E.V.I.E. settings. Copied to ~/.evie/config.yaml by `evie init`.

# Hold this key to talk. alt_r is Right Option on a Mac -- close to your thumb
# and used by nothing else. Others: alt_l, cmd_r, ctrl_r, f13.
hotkey: alt_r

# Phase 5. Leave empty for push-to-talk only, which is what actually works.
wake_word: ""

# Memory lives here. Point it at an Obsidian vault if you already keep one.
vault: ~/EVIE/vault
identity_file: EVIE.md

# How many turns of conversation she carries. Higher costs tokens on every
# request; lower makes her forget what you just said.
transcript_turns: 12

voice:
  tts: kokoro           # kokoro | say | elevenlabs | null
  kokoro_voice: af_heart
  speed: 1.0
  elevenlabs_voice_id: ""

ears:
  model: small.en       # tiny.en is faster; small.en is much better at names
  compute_type: int8
  language: en
